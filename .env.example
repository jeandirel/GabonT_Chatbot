# API FastAPI Moov Assist (assistant RAG) — projet séparé `../api`
# Local
MOOV_API_URL=http://127.0.0.1:8020
NEXT_PUBLIC_MOOV_API_URL=http://127.0.0.1:8020
# Preview / prod Vercel → Railway (exemple teste)
# MOOV_API_URL=https://api-production-c0fd.up.railway.app
# NEXT_PUBLIC_MOOV_API_URL=https://api-production-c0fd.up.railway.app

# Chatbase (optionnel / legacy template) — le chat POC passe par FastAPI
CHATBASE_API_KEY=
CHATBASE_AGENT_ID=

# Persistance et sessions
DATABASE_URL=postgresql://moov:change-me@localhost:5432/moov_assist
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-an-independent-32-character-secret
ADMIN_API_KEY=replace-with-an-independent-admin-secret

# WebAuthn / Passkeys (HTTPS obligatoire hors localhost)
WEBAUTHN_RP_NAME=Moov Assist
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Moov Money API — endpoints à aligner sur la documentation fournie par Moov Money SA
MOOV_MONEY_API_URL=
MOOV_MONEY_API_KEY=

# Fournisseur SMS transactionnel
SMS_API_URL=
SMS_API_KEY=

# CRM / ticketing (Zendesk ou équivalent)
CRM_API_URL=
CRM_API_KEY=
TICKETING_API_URL=
TICKETING_API_KEY=
KYC_API_URL=
KYC_API_KEY=

# Stockage privé compatible S3 des pièces KYC (jamais de bucket public)
S3_REGION=af-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Webhook signature secrets
CHATBASE_WEBHOOK_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=
